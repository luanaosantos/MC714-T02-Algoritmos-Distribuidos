{
  "services": {
    "no-1": {
      "image": "mc714-trabalho2:dev",
      "environment": {
        "NODE_ID": "no-1",
        "PORT": "8000",
        "PEERS": "{\"no-1\": \"http://no-1:8000\", \"no-2\": \"http://no-2:8000\", \"no-3\": \"http://no-3:8000\"}",
        "RUN_ID": "heartbeat-3.0-normal-r0",
        "DATA_DIR": "/dados",
        "LOG_DIR": "/logs",
        "GOSSIP_INTERVAL": "0.1",
        "GOSSIP_ENABLED": "0",
        "HEARTBEAT_INTERVAL": "0.1",
        "HEARTBEAT_TIMEOUT": "3.0",
        "HEARTBEAT_ENABLED": "1",
        "SEED": "101"
      },
      "ports": [
        "127.0.0.1::8000"
      ],
      "volumes": [
        "no-1-data:/dados",
        "no-1-logs:/logs"
      ]
    },
    "no-2": {
